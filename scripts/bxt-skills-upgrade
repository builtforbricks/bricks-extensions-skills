#!/usr/bin/env sh
# Pin this checkout to the latest published release of builtforbricks/bricks-extensions-skills, or to a named tag.
#
#   scripts/bxt-skills-upgrade            move to the latest release (a prerelease install may move to a newer prerelease)
#   scripts/bxt-skills-upgrade v0.2.0     move to that tag
#   scripts/bxt-skills-upgrade --check    say what is installed and what the latest release is, change nothing
#
# Prints one line a client can read: BXT_SKILLS_ALREADY_CURRENT, BXT_SKILLS_UPDATED <old> <new>, BXT_SKILLS_PINNED <tag>,
# or BXT_SKILLS_<REASON> on failure. Needs git, curl and node (for the JSON).
set -eu

ROOT="${BXT_SKILLS_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
API="${BXT_SKILLS_RELEASES_API_URL:-https://api.github.com/repos/builtforbricks/bricks-extensions-skills/releases}"

if ! git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "BXT_SKILLS_NOT_GIT_INSTALL $ROOT"; exit 2
fi
OLD="$(head -n 1 "$ROOT/VERSION" 2>/dev/null || echo unknown)"

MODE="latest"; TAG=""
case "${1:-}" in
  "") ;;
  --check) MODE="check" ;;
  -*) echo "usage: $0 [--check | <tag>]"; exit 2 ;;
  *) TAG="$1"; MODE="tag" ;;
esac

latest_tag() {
  # A prerelease install (a hyphen in its version) may follow prereleases; a release install sees releases only.
  case "$OLD" in
    *-*) URL="$API?per_page=20"; PRE=1 ;;
    *)   URL="$API/latest";      PRE=0 ;;
  esac
  BODY="$(curl -fsL --max-time 8 -H 'Accept: application/vnd.github+json' "$URL")" || { echo "BXT_SKILLS_RELEASE_CHECK_FAILED"; exit 3; }
  printf '%s' "$BODY" | node -e '
    let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => {
      let j; try { j = JSON.parse(s); } catch { process.exit(3); }
      const list = Array.isArray(j) ? j : [j];
      const pick = list.find((r) => r && r.tag_name && !r.draft && (process.argv[1] === "1" || !r.prerelease));
      if (!pick) process.exit(3);
      process.stdout.write(pick.tag_name);
    });' "$PRE" || { echo "BXT_SKILLS_NO_RELEASE_FOUND"; exit 3; }
}

if [ "$MODE" = "check" ]; then
  LATEST="$(latest_tag)"
  echo "BXT_SKILLS_INSTALLED $OLD"
  echo "BXT_SKILLS_LATEST ${LATEST#v}"
  [ "${LATEST#v}" = "$OLD" ] && echo "BXT_SKILLS_ALREADY_CURRENT" || echo "BXT_SKILLS_UPDATE_AVAILABLE $OLD ${LATEST#v}"
  exit 0
fi

[ -n "$TAG" ] || TAG="$(latest_tag)"
case "$TAG" in *[!A-Za-z0-9._+-]*) echo "BXT_SKILLS_BAD_TAG $TAG"; exit 4 ;; esac

git -C "$ROOT" fetch --tags --quiet origin || { echo "BXT_SKILLS_FETCH_FAILED"; exit 4; }
git -C "$ROOT" rev-parse -q --verify "refs/tags/$TAG" >/dev/null || { echo "BXT_SKILLS_RELEASE_TAG_NOT_FOUND $TAG"; exit 4; }

if [ -n "$(git -C "$ROOT" status --porcelain)" ]; then
  git -C "$ROOT" stash push -u -q -m "bxt-skills-upgrade $(date +%Y%m%d%H%M%S)" || { echo "BXT_SKILLS_STASH_FAILED"; exit 5; }
  echo "BXT_SKILLS_LOCAL_CHANGES_STASHED"
fi
git -C "$ROOT" checkout -q --detach "$TAG"
NEW="$(head -n 1 "$ROOT/VERSION" 2>/dev/null || echo unknown)"
if [ "$NEW" = "$OLD" ]; then echo "BXT_SKILLS_PINNED $TAG"; else echo "BXT_SKILLS_UPDATED $OLD $NEW $TAG"; fi
echo "Start a new chat or session so the client loads the refreshed skills."
